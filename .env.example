# ============================================================
# Argos - variáveis de ambiente (VALORES DE DEMONSTRAÇÃO)
# Copie para .env: cp .env.example .env
# Nunca versione o .env nem use estes valores em produção.
# ============================================================

# PostgreSQL
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=argos_dev_only
DB_URL=jdbc:postgresql://localhost:5432/argos
DB_USER=argos
DB_PASSWORD=argos_dev_only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=argos
RABBITMQ_DEFAULT_PASS=argos_dev_only

# JWT (mínimo 32 caracteres; gere um valor próprio: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo-de-demo-por-um-valor-com-48-caracteres-ou-mais

# CORS (origens do frontend, separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# IA: "mock" funciona sem chave de API (respostas determinísticas)
LLM_PROVIDER=mock
LLM_API_KEY=
